<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ bildirim izni. Bu izin olmadan bildirimler
         SESSIZCE calismaz: kullanici hicbir sey gormez, hata da almaz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- android:largeHeap — PDF onizlemesi icin pay birakir.

         PDF onizleme her sayfayi bitmap'e ceviriyor: 150 dpi'da sayfa
         basina ~8 MB. Olculdu, dort sayfalik en agir belge 33 MB —
         cihazin varsayilan 256 MB sinirinin (dalvik.vm.heapgrowthlimit)
         altinda, yani bellek bir DARBOGAZ DEGIL.

         Yine de aciik biraktik: printing paketinin Android tarafi
         (PrintingJob.java) yalnizca IOException yakaliyor;
         OutOfMemoryError olusursa sessizce kaybolur ve ekran
         "Belge Hazirlaniyor"da donar. Cok sinifli, cok sayfali bir
         belgede bu sinira yaklasilirsa diye siniri 512 MB'a cikarir.
         Maliyeti yok. -->
    <application
        android:label="SınıfCepte"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!--
            Baglanti acma (url_launcher).

            Android 11'den itibaren uygulama, hangi uygulamalarin hangi
            islemi yapabildigini goremiyor; bunu burada BILDIRMEK
            gerekiyor. Bildirilmeyince `canLaunchUrl` HER ZAMAN false
            donuyor ve "Baglanti acilamadi" hatasi veriyordu — sinav
            basvuru sayfalari hic acilmiyordu.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
