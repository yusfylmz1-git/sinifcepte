rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yönetici mi?
    //
    // `adminRole` anahtarının VARLIĞI önce kontrol edilir: sıradan
    // kullanıcının token'ında bu alan yoktur ve doğrudan karşılaştırma
    // "Property adminRole is undefined" hatasıyla kuralı düşürür.
    // Bu, `isAdmin()` bir `||` zincirinin başında kullanıldığında
    // meşru erişimi de engelliyordu.
    function isAdmin() {
      return request.auth != null
        && 'adminRole' in request.auth.token
        && (request.auth.token.adminRole == 'super'
            || request.auth.token.adminRole == 'moderator');
    }
    function isSuper() {
      return request.auth != null
        && 'adminRole' in request.auth.token
        && request.auth.token.adminRole == 'super';
    }
    // Veli mi?
    //
    // ESKİDEN `request.auth.token.role == 'parent'` custom claim'ine
    // bakıyordu. Custom claim yalnızca Admin SDK ile yazılabilir; bu
    // projede Cloud Functions YOK, dolayısıyla claim hiçbir zaman
    // yazılmıyordu. Sonuç: koşul HER ZAMAN false döndü — veli mesaj
    // gönderemiyor, randevu isteyemiyor, durum bildirimi yapamıyordu.
    // Cihazdaki log bunu PERMISSION_DENIED olarak gösteriyordu.
    //
    // Gerçek koruma zaten claim'de değil, bağ kaydında: bu fonksiyonun
    // kullanıldığı her yerde `parentHasStudent(...)` ya da
    // `parentUserId == request.auth.uid` koşulu birlikte aranır. Bağ
    // kaydı, velinin O ÖĞRENCİYE bağlı olduğunu kanıtlar — claim'in
    // veremeyeceği bir güvence. Burada yalnızca oturum açık olması
    // yeterlidir; yetkiyi eşlik eden koşullar verir.
    function isParent() {
      return request.auth != null;
    }

    // Onaylı okul yöneticisi mi?
    //
    // Yetkiyi veren şey custom claim'dir; claim yalnızca Admin SDK ile
    // (scripts/admin/approve_school_admin.mjs) yazılır. Firestore'daki
    // başvuru kaydının 'approved' olması TEK BAŞINA yetki vermez —
    // başvuran kendi kaydını onaylayamadığı gibi, onaylayabilseydi bile
    // buradan geçemezdi.
    function isApprovedSchoolAdmin() {
      return request.auth != null
        && request.auth.token.schoolAdminStatus == 'approved';
    }

    // Yönetici yetkisi kendi okuluyla sınırlıdır: bir okulun yöneticisi
    // başka okulun şikâyetlerini göremez.
    function isSchoolAdminOf(schoolId) {
      return isApprovedSchoolAdmin()
        && request.auth.token.schoolId == schoolId;
    }
    function ownsClassRoom(classCloudId) {
      return request.auth != null
        && classCloudId.matches('cls_' + request.auth.uid + '_.*');
    }
    function parentHasClass(classCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/parent_class_access/$(request.auth.uid + '_' + classCloudId)
      );
    }
    function parentHasStudent(studentCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/parent_links/$(request.auth.uid + '_' + studentCloudId)
      );
    }

    // --- Token köprüsü yardımcıları (Faz 2) ---

    // Velinin dayandığı referans kodu GERÇEKTEN var mı ve bu öğrenciye
    // mi ait?
    //
    // GÜVENLİK AÇIĞI DÜZELTMESİ (31 Ağustos 2026):
    // Kural yorumunda "dayandığı token hâlâ kullanılabilir olmalı"
    // yazıyordu ama **böyle bir kontrol yoktu**. Giriş yapmış herhangi
    // biri, referans kodu olmadan, yalnızca sınıf kimliğini tahmin
    // ederek (`cls_{ogretmenUid}_{sayi}` — tahmin edilebilir bir desen)
    // kendine veli bağı yazabiliyor ve **sınıf duyurularını
    // okuyabiliyordu**. Emülatörde kanıtlandı.
    //
    // Artık bağ kurmak için kodun hash'i doküman olarak var olmalı ve
    // içindeki öğrenci kimliği bağdakiyle aynı olmalı. Kodu bilmeyen
    // kimse bağ kuramaz.
    function tokenGecerli(codeHash, studentCloudId) {
      return codeHash is string
        && codeHash.size() > 0
        && exists(/databases/$(database)/documents/parent_tokens/$(codeHash))
        && get(/databases/$(database)/documents/parent_tokens/$(codeHash))
             .data.studentCloudId == studentCloudId;
    }


    // Öğretmen, kimliğinde kendi uid'si geçen kaynakların sahibidir.
    // Sahiplik denetimi doküman okumadan, yalnızca kimlik deseninden yapılır:
    // bu hem ücretsiz hem gecikmesizdir.
    function ownsStudent(studentCloudId) {
      return request.auth != null
        && studentCloudId.matches('stu_' + request.auth.uid + '_.*');
    }

    // Veli bağ kaydını yalnızca kendi adına oluşturabilir.
    function isOwnParentLink(id) {
      return request.auth != null && id.matches(request.auth.uid + '_.*');
    }

    // Sınıfın branş öğretmeni kadrosunda mı?
    //
    // Duyuru yetkisi sahipliğe bağlıdır (yalnızca sınıf öğretmeni), ancak
    // MESAJLAŞMA farklı bir eksendir: veli, çocuğunun dersine giren branş
    // öğretmenleriyle de yazışabilmelidir. Kadro üyeliği sınıf öğretmeni
    // tarafından yönetilir.
    //
    // Bu fonksiyon exists() ile doküman okur — kimlik deseninden
    // çıkarılamayan tek yetkidir. Yalnızca mesajlaşma yollarında kullanılır,
    // sık çağrılan duyuru/okuma yollarında değil.
    // Not: Kimlik olarak kullanıcının kendi UID'si aranır. Sınıf öğretmeni
    // Kadroya yalnızca sınıf öğretmeni ekleme yapar ve yalnızca okul
    // dizininde kayıtlı (yani uygulamaya girmiş) öğretmenleri ekleyebilir;
    // bu yüzden kadrodaki her satır gerçek bir Firebase UID'sidir.
    function isClassStaff(classCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/class_rooms/$(classCloudId)/staff/$(request.auth.uid)
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow write: if isSuper();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /school_merge_queue/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /sync/manifest {
      allow read: if true;
      allow write: if false;
    }

    // Okul öğretmen dizini.
    //
    // Öğretmen okulunu seçtiğinde buraya kaydolur. Amaç: sınıf öğretmeni
    // kadroyu kurarken meslektaşlarını kod alışverişi olmadan seçebilsin.
    //
    // Gizlilik: yalnızca ad, branş ve e-posta bulunur — öğrenci, sınıf
    // veya not verisi ASLA. Aynı okuldaki öğretmenler birbirini görür
    // (gerçek hayatta da öyle); veliler bu listeye erişemez.
    match /school_teachers/{id} {
      // Dizini yalnızca AYNI OKULDA kayıtlı öğretmenler okur.
      //
      // Eski kural `request.auth.token.role != 'parent'` claim'ine
      // bakıyordu. O claim hiçbir zaman yazılmadığı için (Admin SDK
      // gerekir, projede Cloud Functions yok) koşul herkese açıktı —
      // veli de dizini okuyabiliyordu. Testler bunu kaçırdı çünkü
      // veliye sahte claim veriyorlardı.
      //
      // Yeni koşul kanıta dayanır: okuyan kişinin kendi kaydı bu okulda
      // olmalı. Öğretmen okulunu seçtiğinde bu kayıt oluşur; velinin
      // böyle bir kaydı hiç olmaz. `get()` yerine `exists()` kullanılır
      // ve yalnızca bu yolda çağrılır (sık değil).
      allow read: if request.auth != null && exists(
        /databases/$(database)/documents/school_teachers/$(resource.data.schoolId + '_' + request.auth.uid)
      );

      // Herkes yalnızca KENDİ kaydını yazabilir: doküman kimliği
      // "{schoolId}_{uid}" olduğu için kimlik ve içerik birlikte denetlenir.
      allow create, update: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && id == request.resource.data.schoolId + '_' + request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.teacherUid == request.auth.uid;
    }

    // Veli referans kodları. Doküman kimliği SHA-256(kod)'un kendisidir;
    // düz kod hiçbir zaman saklanmaz. Bu sayede:
    //  - veritabanını ele geçiren biri kodları geri üretemez,
    //  - doğrulama sorgu değil tek get() olur (indeks yok, tek okuma).
    match /parent_tokens/{codeHash} {
      // Veli kodu doğrulamak için okumak zorundadır. Kimliği bilmek kodu
      // bilmeyi gerektirdiğinden bu, kodun kendisinden fazla bilgi vermez.
      allow get: if request.auth != null;
      // Listeleme yasak: aksi halde tüm kodlar taranabilirdi.
      allow list: if false;

      // Yalnızca kodu üreten öğretmen yazabilir/silebilir.
      allow create, update: if ownsStudent(request.resource.data.studentCloudId)
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if ownsStudent(resource.data.studentCloudId);
    }

    match /parent_links/{id} {
      // Veli kendi bağını okur; öğrencinin sahibi öğretmen de okur.
      //
      // Öğretmen yetkisi gerekli: mesaj kutusunda "hangi veli bağlandı"
      // listesini buradan alır. Bu izin olmadan öğretmen kime yazacağını
      // hiç göremiyordu — veli mesaj gönderiyor ama öğretmende hiçbir
      // yerde görünmüyordu.
      //
      // `list` de açıktır (sorgu için); `ownsStudent` deseni öğretmeni
      // yalnızca KENDİ öğrencilerinin bağlarıyla sınırlar.
      // Sorgular `where(teacherUid == uid)` ile daraltılır; kural da
      // aynı kısıtı arar, böylece kimse tüm bağları tarayamaz.
      // `teacherUid` alani da kabul edilir.
      //
      // Ogretmen mesaj kutusu icin `where('teacherUid', isEqualTo: uid)`
      // ile SORGU yapiyor. `ownsStudent` yalnizca dokuman kimligi
      // desenine bakiyor ve liste sorgusunda degerlendirilemiyordu:
      // her sorgu PERMISSION_DENIED aliyordu. Ana sayfa akisi eklenince
      // bu hata gorunur hale geldi.
      allow read: if isOwnParentLink(id)
        || ownsStudent(resource.data.studentCloudId)
        || (request.auth != null
            && resource.data.teacherUid == request.auth.uid);

      // Veli bağı kendi adına kurar. Üç koşul birlikte sağlanmalıdır:
      //  1. Doküman kimliği kendi uid'siyle başlamalı,
      //  2. içindeki parentUid kendi uid'si olmalı,
      //  3. dayandığı token hâlâ kullanılabilir olmalı.
      // Üçüncü koşul (token doğrulaması) yorumda yazılıydı ama KODDA
      // YOKTU; bu bir güvenlik açığıydı. Bkz. `tokenGecerli`.
      allow create: if isOwnParentLink(id)
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.status == 'active'
        && tokenGecerli(
             request.resource.data.codeHash,
             request.resource.data.studentCloudId
           );

      // Veli yalnızca bağı arşivleyebilir (bağlantıyı kendi kaldırabilir).
      allow update: if isOwnParentLink(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Silme: veli kendi bağını kaldırabilir (KVKK unutulma hakkı),
      // öğrencinin sahibi öğretmen de kaldırabilir.
      allow delete: if isOwnParentLink(id)
        || ownsStudent(resource.data.studentCloudId);
    }

    match /parent_class_access/{id} {
      allow read: if isOwnParentLink(id);

      // Oluşturma: veli kendi bağını kurarken, öğretmen ise şube
      // değişikliğinde yeni sınıfın erişimini yazar.
      // Veli tarafı için bağın GERÇEKTEN kurulmuş olması şart:
      // `parent_class_access` tek başına yazılabilseydi, sahte erişimle
      // sınıf duyuruları okunabilirdi (emülatörde kanıtlandı).
      allow create: if (isOwnParentLink(id)
          && request.resource.data.parentUid == request.auth.uid
          && exists(/databases/$(database)/documents/parent_links/$(
               request.auth.uid + '_' + request.resource.data.studentCloudId
             )))
        || ownsStudent(request.resource.data.studentCloudId);

      // Silme: veli kendi erişimini bırakabilir; öğrencinin sahibi
      // öğretmen de kaldırabilir.
      //
      // Öğretmen yetkisi zorunludur: öğrenci okuldan ayrıldığında
      // (mezuniyet, başka okula nakil, kayıt silme) ya da şube
      // değiştirdiğinde bu kaydın kalkması gerekir. Yalnızca veli
      // silebilseydi, ayrılmış öğrencinin velisi sınıf duyurularını
      // görmeye devam ederdi.
      allow delete: if isOwnParentLink(id)
        || ownsStudent(resource.data.studentCloudId);

      // Şube değişikliğinde öğretmen yeni erişimi yazar.
      allow update: if ownsStudent(resource.data.studentCloudId);
    }

    // Okul yöneticiliği başvuruları. Öğretmen kendi başvurusunu görür ve
    // oluşturur; kararı yalnızca süper admin verir.
    match /school_admin_requests/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.teacherUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Başvuran kendi kararını yazamaz — yetki yükseltmeyi engeller.
      allow update, delete: if isSuper();
    }

    // Veli şikâyetleri.
    //
    // Okuma yetkisi iki gruba açıktır:
    //  - Moderatör/süper admin: tüm şikâyetler
    //  - Onaylı okul yöneticisi: YALNIZCA kendi okulunun şikâyetleri
    //
    // Yöneticinin işi tam olarak budur (kullanıcı kurgusu), ama yetkisi
    // kendi okuluyla sınırlıdır. Şikâyeti gönderen veli bile sonradan
    // okuyamaz: denetim izi tek yönlüdür.
    match /content_reports/{id} {
      allow read: if isAdmin() || isSchoolAdminOf(resource.data.schoolId);

      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';

      // Okul yöneticisi şikâyeti "incelendi" olarak işaretleyebilir;
      // içeriğine dokunamaz (denetim izi bütünlüğü).
      allow update: if isSchoolAdminOf(resource.data.schoolId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewNote', 'reviewedAt']);

      allow update, delete: if isSuper();
    }

    // Sınıf odası: yalnızca sınıfın kimliği, adı, okulu ve öğretmeni.
    // Öğrenci listesi, not, katılım gibi veriler buraya ASLA yazılmaz —
    // onlar öğretmenin yerel SQLite'ında kalır (offline-first + KVKK).
    match /class_rooms/{classCloudId} {
      allow read: if ownsClassRoom(classCloudId) || parentHasClass(classCloudId);

      // Duyuru yetkisi kararı gereği sınıf odasının sahibi tek öğretmendir.
      allow create, update: if ownsClassRoom(classCloudId)
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if ownsClassRoom(classCloudId);

      // Duyuru: yalnızca sınıf öğretmeni yayımlar (kullanıcı kararı).
      // Veli duyuruyu okur ama dokümanın kendisine YAZAMAZ — okundu bilgisi
      // ayrı bir alt koleksiyona düşer (aşağıya bakınız).
      match /announcements/{id} {
        allow read: if ownsClassRoom(classCloudId) || parentHasClass(classCloudId);

        // Duyuru yazma yetkisi KADROYA açıldı.
        //
        // Önceden yalnızca sınıf öğretmeni yazabiliyordu. Ama matematik
        // öğretmeni de "yarın quiz var" ya da "sayfa 42 ödev" duyurusu
        // yapmak istiyor; şu an bunu ancak rehber öğretmenden rica
        // ederek yapabiliyordu.
        //
        // `isClassStaff` doküman okur (exists) — bu yol duyuru
        // YAZMADA çalışır, sık çağrılan okuma yolunda değil.
        //
        // Yazarın kimliği doğrulanır: kadrodaki öğretmen başkasının
        // adına duyuru yayımlayamaz.
        allow create: if (ownsClassRoom(classCloudId)
            || isClassStaff(classCloudId))
          && request.resource.data.authorUid == request.auth.uid;

        // Düzenleme ve silme YALNIZCA yazarına ya da sınıf öğretmenine
        // açıktır: kadrodaki bir öğretmen başkasının duyurusunu
        // değiştiremez.
        allow update, delete: if ownsClassRoom(classCloudId)
          || (isClassStaff(classCloudId)
              && resource.data.authorUid == request.auth.uid);

        // Okundu bilgisi (maliyet kararı #1).
        // Eskiden duyuru dokümanı içinde readBy[] dizisiydi: 30 velinin her
        // biri aynı dokümanı okuyup diziye kendini ekleyip geri yazıyordu —
        // 30 okuma + 30 yazma + eşzamanlılık çakışması. Artık her veli
        // yalnızca kendi küçük dokümanını yazar; öğretmen sayıyı count()
        // toplama sorgusuyla alır (1000 dokümana kadar tek okuma).
        match /reads/{parentUid} {
          allow read: if ownsClassRoom(classCloudId)
            || (request.auth != null && request.auth.uid == parentUid);

          // Veli yalnızca kendi okundu kaydını yazabilir.
          allow create, update: if request.auth != null
            && request.auth.uid == parentUid
            && parentHasClass(classCloudId);

          allow delete: if ownsClassRoom(classCloudId);
        }
      }

      // Randevular. Veli talep eder, öğretmen yanıtlar.
      // Kadrodaki branş öğretmenleri de yanıtlayabilir: veli onlarla da
      // görüşme talep edebildiği için (mesajlaşmayla aynı yetki ekseni).
      match /appointments/{id} {
        allow read: if ownsClassRoom(classCloudId)
          || isClassStaff(classCloudId)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));

        allow create: if isParent()
          && parentHasStudent(request.resource.data.studentCloudId)
          && request.resource.data.parentUserId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Öğretmen onaylar/reddeder.
        allow update: if ownsClassRoom(classCloudId) || isClassStaff(classCloudId);

        // Veli kendi talebini iptal edebilir (yalnızca durum alanı).
        allow update: if isParent()
          && resource.data.parentUserId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'respondedAt'])
          && request.resource.data.status == 'cancelled';

        allow delete: if ownsClassRoom(classCloudId);
      }

      // Mesajlaşma: duyurudan FARKLI bir yetki eksenidir (kullanıcı kararı).
      // Duyuruyu yalnızca sınıf öğretmeni yapar, ancak veli çocuğunun
      // dersine giren BRANŞ öğretmenleriyle de yazışabilmelidir. Bu yüzden
      // burada sınıf sahipliği tek yeterli koşul değildir: sınıf kadrosunda
      // kayıtlı olan öğretmen de yazışabilir.
      match /messages/{id} {
        // Branş öğretmeni YALNIZCA kendi sohbetini okur. Aksi hâlde
        // kadrodaki her öğretmen, velinin diğer öğretmenlerle yazışmasını
        // da görebiliyordu. Sınıf öğretmeni (oda sahibi) tümünü görür.
        allow read: if ownsClassRoom(classCloudId)
          || (isClassStaff(classCloudId)
              && resource.data.teacherUid == request.auth.uid)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));

        // `teacherUid` yazışmanın hangi öğretmenle olduğunu belirler.
        // Zorunludur: bu alan olmadan mesajlar yalnızca öğrenciye göre
        // filtrelendiği için velinin tüm öğretmenlerle yazışması tek
        // sohbette birikiyor, her öğretmen diğerlerininkini görebiliyordu.
        //
        // Doğrulama `request.resource.data` üzerinden yapılır; ek `get()`
        // gerektirmediği için faturalanan okuma doğurmaz.
        allow create: if (
            (ownsClassRoom(classCloudId) || isClassStaff(classCloudId))
            && request.resource.data.authorRole == 'teacher'
            && request.resource.data.authorUid == request.auth.uid
            // Öğretmen yalnızca kendi sohbetine yazabilir.
            && request.resource.data.teacherUid == request.auth.uid
          ) || (
            isParent()
            && parentHasStudent(request.resource.data.studentCloudId)
            && request.resource.data.parentUserId == request.auth.uid
            && request.resource.data.authorRole == 'parent'
            && request.resource.data.teacherUid is string
            && request.resource.data.teacherUid != ''
          );

        // Mesaj gönderildikten sonra içeriği değiştirilemez.
        allow update: if false;
        allow delete: if ownsClassRoom(classCloudId);
      }

      // Sınıfın branş öğretmeni kadrosu. Sınıf öğretmeni yönetir; veli
      // "çocuğumun dersine kimler giriyor" listesini buradan okur.
      match /staff/{staffId} {
        // Katılım kodunu doğrulayabilmek için giriş yapmış her öğretmen
        // okuyabilir. Kadro yalnızca ad/branş/görüşme saati içerir —
        // öğrenci verisi veya iletişim bilgisi barındırmaz.
        allow read: if request.auth != null || parentHasClass(classCloudId);

        // Sınıf öğretmeni kadroyu yönetir.
        allow create, update, delete: if ownsClassRoom(classCloudId);

        // Katılım kodlu ("pending_{kod}") yol kaldırıldı. Kadroyu
        // yalnızca sınıf öğretmeni yönetir (yukarıdaki kural); öğretmen
        // kendini kadroya EKLEYEMEZ. Bu, davet edilmemiş hiç kimsenin
        // mesajlaşma yetkisi kazanamayacağını garanti eder.
      }

      // Durum bildirimleri (ilaç, erken çıkış, not).
      // Öğrencinin sağlık/durum bilgisini taşır: yalnızca sınıfın
      // öğretmenleri ve bildirimi gönderen veli erişebilir.
      match /status_reports/{id} {
        allow read: if ownsClassRoom(classCloudId)
          || isClassStaff(classCloudId)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));

        allow create: if isParent()
          && parentHasStudent(request.resource.data.studentCloudId)
          && request.resource.data.parentUserId == request.auth.uid
          && request.resource.data.status == 'pending';

        // Öğretmen "görüldü" işaretler ve not ekler.
        // Veli bildirimi gönderdikten sonra içeriğini DEĞİŞTİREMEZ:
        // öğretmen "ilaç saat 12:30" diye okuduktan sonra metin değişirse
        // sorumluluk belirsizleşirdi.
        allow update: if ownsClassRoom(classCloudId) || isClassStaff(classCloudId);

        allow delete: if ownsClassRoom(classCloudId);
      }
    }

    // ---------------------------------------------------------------
    // DESTEK TALEPLERİ
    // ---------------------------------------------------------------
    //
    // Modal "Destek Talebini Gönder" diyor ve "24 saat içinde yanıtlanır"
    // vaat ediyordu; oysa talep yalnızca cihazdaki yerel denetim
    // günlüğüne yazılıyor, kimse görmüyordu.
    //
    // Okuma YALNIZCA kendi talebi icin. Kullanici "Taleplerim" ekraninda
    // gonderdigi talebi ve verilen cevabi gorur; baskasinin talebini
    // goremez (talepler ogrenci adi, okul ve sorun aciklamasi tasiyabilir).
    match /support_requests/{requestId} {
      // Kullanıcı kendi talebini okur ("Taleplerim" ekranı).
      //
      // YÖNETİCİ DE OKUYABİLMELİ: aksi hâlde destek talebi kimsenin
      // göremediği bir kuyuya düşer. Bağımsız denetimde yakalandı:
      // "talep Firestore'a yazılır ama yönetici okuyamaz; bu bir
      // operasyon değildir."
      allow read: if (request.auth != null
            && resource.data.userId == request.auth.uid)
        || isAdmin();

      // Yönetici talebi "çözüldü" olarak işaretleyebilir.
      allow update: if isAdmin();

      // Herkes YALNIZCA kendi adına talep oluşturabilir.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        // Durum alanı istemciden 'open' dışında gelemez: kullanıcı
        // kendi talebini "çözüldü" işaretleyemez.
        && request.resource.data.status == 'open';

      // Gönderen kullanıcı talebini değiştiremez ve silemez: aksi hâlde
      // yanıtlanmış bir talebi sonradan değiştirip yazışmayı
      // anlamsızlaştırabilirdi. (Yönetici güncellemesi yukarıda.)
      allow delete: if false;
    }
  }
}
