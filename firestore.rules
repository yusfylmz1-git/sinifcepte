rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.adminRole == 'super'
            || request.auth.token.adminRole == 'moderator');
    }
    function isSuper() {
      return request.auth != null && request.auth.token.adminRole == 'super';
    }
    function isParent() {
      return request.auth != null && request.auth.token.role == 'parent';
    }
    function ownsClassRoom(classCloudId) {
      return request.auth != null
        && classCloudId.matches('cls_' + request.auth.uid + '_.*');
    }
    function parentHasClass(classCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/parent_class_access/$(request.auth.uid + '_' + classCloudId)
      );
    }
    function parentHasStudent(studentCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/parent_links/$(request.auth.uid + '_' + studentCloudId)
      );
    }

    // --- Token köprüsü yardımcıları (Faz 2) ---

    // Öğretmen, kimliğinde kendi uid'si geçen kaynakların sahibidir.
    // Sahiplik denetimi doküman okumadan, yalnızca kimlik deseninden yapılır:
    // bu hem ücretsiz hem gecikmesizdir.
    function ownsStudent(studentCloudId) {
      return request.auth != null
        && studentCloudId.matches('stu_' + request.auth.uid + '_.*');
    }

    // Veli bağ kaydını yalnızca kendi adına oluşturabilir.
    function isOwnParentLink(id) {
      return request.auth != null && id.matches(request.auth.uid + '_.*');
    }

    // Sınıfın branş öğretmeni kadrosunda mı?
    //
    // Duyuru yetkisi sahipliğe bağlıdır (yalnızca sınıf öğretmeni), ancak
    // MESAJLAŞMA farklı bir eksendir: veli, çocuğunun dersine giren branş
    // öğretmenleriyle de yazışabilmelidir. Kadro üyeliği sınıf öğretmeni
    // tarafından yönetilir.
    //
    // Bu fonksiyon exists() ile doküman okur — kimlik deseninden
    // çıkarılamayan tek yetkidir. Yalnızca mesajlaşma yollarında kullanılır,
    // sık çağrılan duyuru/okuma yollarında değil.
    function isClassStaff(classCloudId) {
      return request.auth != null && exists(
        /databases/$(database)/documents/class_rooms/$(classCloudId)/staff/$(request.auth.uid)
      );
    }

    // Token dokümanının hâlâ kullanılabilir olduğunu doğrular.
    // Veli, süresi dolmuş veya kotası dolmuş bir kodla bağ kuramaz.
    function tokenUsable(codeHash) {
      let tok = get(/databases/$(database)/documents/parent_tokens/$(codeHash)).data;
      return tok.status == 'active'
        && tok.linkedParentCount < tok.maxLinkedParents
        && request.time < timestamp.date(2100, 1, 1);
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_users/{uid} {
      allow read: if isAdmin();
      allow write: if isSuper();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /school_merge_queue/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /sync/manifest {
      allow read: if true;
      allow write: if false;
    }

    // Veli referans kodları. Doküman kimliği SHA-256(kod)'un kendisidir;
    // düz kod hiçbir zaman saklanmaz. Bu sayede:
    //  - veritabanını ele geçiren biri kodları geri üretemez,
    //  - doğrulama sorgu değil tek get() olur (indeks yok, tek okuma).
    match /parent_tokens/{codeHash} {
      // Veli kodu doğrulamak için okumak zorundadır. Kimliği bilmek kodu
      // bilmeyi gerektirdiğinden bu, kodun kendisinden fazla bilgi vermez.
      allow get: if request.auth != null;
      // Listeleme yasak: aksi halde tüm kodlar taranabilirdi.
      allow list: if false;

      // Yalnızca kodu üreten öğretmen yazabilir/silebilir.
      allow create, update: if ownsStudent(request.resource.data.studentCloudId)
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if ownsStudent(resource.data.studentCloudId);
    }

    match /parent_links/{id} {
      allow read: if isOwnParentLink(id);

      // Veli bağı kendi adına kurar. Üç koşul birlikte sağlanmalıdır:
      //  1. Doküman kimliği kendi uid'siyle başlamalı,
      //  2. içindeki parentUid kendi uid'si olmalı,
      //  3. dayandığı token hâlâ kullanılabilir olmalı.
      allow create: if isOwnParentLink(id)
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.status == 'active';

      // Veli yalnızca bağı arşivleyebilir (bağlantıyı kendi kaldırabilir).
      allow update: if isOwnParentLink(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Silme: veli kendi bağını kaldırabilir (KVKK unutulma hakkı),
      // öğrencinin sahibi öğretmen de kaldırabilir.
      allow delete: if isOwnParentLink(id)
        || ownsStudent(resource.data.studentCloudId);
    }

    match /parent_class_access/{id} {
      allow read: if isOwnParentLink(id);

      allow create: if isOwnParentLink(id)
        && request.resource.data.parentUid == request.auth.uid;

      allow delete: if isOwnParentLink(id);
      allow update: if false;
    }

    // Okul yöneticiliği başvuruları. Öğretmen kendi başvurusunu görür ve
    // oluşturur; kararı yalnızca süper admin verir.
    match /school_admin_requests/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.teacherUid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Başvuran kendi kararını yazamaz — yetki yükseltmeyi engeller.
      allow update, delete: if isSuper();
    }

    // Veli şikâyetleri. Veli oluşturur, okul yöneticisi ve moderatör okur.
    match /content_reports/{id} {
      allow read: if isAdmin();

      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;

      // Şikâyet kaydı sonradan değiştirilemez (denetim izi bütünlüğü).
      allow update, delete: if isSuper();
    }

    // Sınıf odası: yalnızca sınıfın kimliği, adı, okulu ve öğretmeni.
    // Öğrenci listesi, not, katılım gibi veriler buraya ASLA yazılmaz —
    // onlar öğretmenin yerel SQLite'ında kalır (offline-first + KVKK).
    match /class_rooms/{classCloudId} {
      allow read: if ownsClassRoom(classCloudId) || parentHasClass(classCloudId);

      // Duyuru yetkisi kararı gereği sınıf odasının sahibi tek öğretmendir.
      allow create, update: if ownsClassRoom(classCloudId)
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if ownsClassRoom(classCloudId);

      // Duyuru: yalnızca sınıf öğretmeni yayımlar (kullanıcı kararı).
      // Veli duyuruyu okur ama dokümanın kendisine YAZAMAZ — okundu bilgisi
      // ayrı bir alt koleksiyona düşer (aşağıya bakınız).
      match /announcements/{id} {
        allow read: if ownsClassRoom(classCloudId) || parentHasClass(classCloudId);
        allow create, update, delete: if ownsClassRoom(classCloudId);

        // Okundu bilgisi (maliyet kararı #1).
        // Eskiden duyuru dokümanı içinde readBy[] dizisiydi: 30 velinin her
        // biri aynı dokümanı okuyup diziye kendini ekleyip geri yazıyordu —
        // 30 okuma + 30 yazma + eşzamanlılık çakışması. Artık her veli
        // yalnızca kendi küçük dokümanını yazar; öğretmen sayıyı count()
        // toplama sorgusuyla alır (1000 dokümana kadar tek okuma).
        match /reads/{parentUid} {
          allow read: if ownsClassRoom(classCloudId)
            || (request.auth != null && request.auth.uid == parentUid);

          // Veli yalnızca kendi okundu kaydını yazabilir.
          allow create, update: if request.auth != null
            && request.auth.uid == parentUid
            && parentHasClass(classCloudId);

          allow delete: if ownsClassRoom(classCloudId);
        }
      }

      match /appointments/{id} {
        allow read: if ownsClassRoom(classCloudId)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));
        allow create: if isParent()
          && parentHasStudent(request.resource.data.studentCloudId)
          && request.resource.data.parentUserId == request.auth.uid;
        allow update: if ownsClassRoom(classCloudId);
      }

      // Mesajlaşma: duyurudan FARKLI bir yetki eksenidir (kullanıcı kararı).
      // Duyuruyu yalnızca sınıf öğretmeni yapar, ancak veli çocuğunun
      // dersine giren BRANŞ öğretmenleriyle de yazışabilmelidir. Bu yüzden
      // burada sınıf sahipliği tek yeterli koşul değildir: sınıf kadrosunda
      // kayıtlı olan öğretmen de yazışabilir.
      match /messages/{id} {
        allow read: if ownsClassRoom(classCloudId)
          || isClassStaff(classCloudId)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));

        allow create: if (
            (ownsClassRoom(classCloudId) || isClassStaff(classCloudId))
            && request.resource.data.authorRole == 'teacher'
            && request.resource.data.authorUid == request.auth.uid
          ) || (
            isParent()
            && parentHasStudent(request.resource.data.studentCloudId)
            && request.resource.data.parentUserId == request.auth.uid
            && request.resource.data.authorRole == 'parent'
          );

        // Mesaj gönderildikten sonra içeriği değiştirilemez.
        allow update: if false;
        allow delete: if ownsClassRoom(classCloudId);
      }

      // Sınıfın branş öğretmeni kadrosu. Sınıf öğretmeni yönetir; veli
      // "çocuğumun dersine kimler giriyor" listesini buradan okur.
      match /staff/{teacherUid} {
        allow read: if ownsClassRoom(classCloudId)
          || isClassStaff(classCloudId)
          || parentHasClass(classCloudId);
        allow create, update, delete: if ownsClassRoom(classCloudId);
      }

      match /status_reports/{id} {
        allow read: if ownsClassRoom(classCloudId)
          || isClassStaff(classCloudId)
          || (isParent() && parentHasStudent(resource.data.studentCloudId));
        allow create: if isParent()
          && parentHasStudent(request.resource.data.studentCloudId)
          && request.resource.data.parentUserId == request.auth.uid;
        allow update: if ownsClassRoom(classCloudId) || isClassStaff(classCloudId);
      }
    }
  }
}
